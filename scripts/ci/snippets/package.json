{
  "name": "sui-skills-snippet-check",
  "private": true,
  "version": "0.0.0",
  "description": "Type-checks TS code blocks extracted from skills/*/SKILL.md against real @mysten/* SDK versions to prevent hallucinated APIs from regressing.",
  "scripts": {
    "extract": "node extract.mjs",
    "check": "node extract.mjs && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@mysten/dapp-kit-core": "1.6.3",
    "@mysten/dapp-kit-react": "2.1.5",
    "@mysten/deepbook-v3": "1.5.3",
    "@mysten/enoki": "1.2.1",
    "@mysten/kiosk": "1.3.3",
    "@mysten/messaging": "0.3.0",
    "@mysten/seal": "1.2.3",
    "@mysten/sui": "2.20.1",
    "@mysten/suins": "1.2.3",
    "@mysten/wallet-standard": "0.21.3",
    "@mysten/walrus": "1.2.3",
    "@mysten/zksend": "1.2.3",
    "@tanstack/react-query": "5.62.7",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "typescript": "5.7.2"
  }
}
