{
  "name": "sui-skills-snippet-check",
  "private": true,
  "version": "0.0.0",
  "description": "Type-checks TS code blocks extracted from skills/*/SKILL.md against real @mysten/* SDK versions to prevent hallucinated APIs from regressing.",
  "scripts": {
    "extract": "node extract.mjs",
    "check": "node extract.mjs && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@mysten/dapp-kit-core": "1.6.22",
    "@mysten/dapp-kit-react": "2.1.24",
    "@mysten/deepbook-v3": "2.0.1",
    "@mysten/enoki": "1.2.19",
    "@mysten/kiosk": "1.4.7",
    "@mysten/messaging": "0.3.0",
    "@mysten/seal": "1.4.7",
    "@mysten/sui": "2.28.0",
    "@mysten/suins": "2.0.3",
    "@mysten/wallet-standard": "0.21.21",
    "@mysten/walrus": "1.2.22",
    "@mysten/zksend": "1.2.22",
    "@tanstack/react-query": "5.62.7",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "typescript": "5.7.2"
  }
}
